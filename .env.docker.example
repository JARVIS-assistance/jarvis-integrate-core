JARVIS_CORE_PORT=3010
JARVIS_CONTROLLER_PORT=3011
JARVIS_GATEWAY_PORT=3012
JARVIS_AI_WORKBENCH_PORT=3013

# jarvis-core
JARVIS_AUTH_SECRET=change-this-in-production
# Leave blank to use SQLite in the container volume.
JARVIS_CORE_DB_URL=
JARVIS_CORE_DB_USER=
JARVIS_CORE_DB_PASSWORD=
JARVIS_CORE_DB_HOST=
JARVIS_CORE_DB_PORT=5432
JARVIS_CORE_DB_NAME=postgres

# jarvis-gateway
JARVIS_GATEWAY_RATE_LIMIT=60
JARVIS_GATEWAY_RATE_WINDOW=60

# jarvis-tts-runtime
JARVIS_TTS_RUNTIME_PORT=3031
JARVIS_TTS_RUNTIME_DEFAULT_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
JARVIS_TTS_RUNTIME_MODELS=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice,Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice,Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
JARVIS_TTS_RUNTIME_DEFAULT_SPEAKER=Sohee
JARVIS_TTS_RUNTIME_LANGUAGE=Korean
JARVIS_TTS_RUNTIME_DEVICE=auto
JARVIS_TTS_RUNTIME_DTYPE=auto
JARVIS_TTS_RUNTIME_ATTN=
JARVIS_TTS_RUNTIME_PRELOAD_MODEL=1
JARVIS_TTS_RUNTIME_PRELOAD_REQUIRED=1

# jarvis-core -> jarvis-tts-runtime
JARVIS_TTS_SERVER_URL=http://jarvis-tts-runtime:8031
JARVIS_TTS_SERVER_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
JARVIS_TTS_MODELS=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice,Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice,Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
JARVIS_TTS_TIMEOUT_SECONDS=300
